# Copiá este archivo como .env y completá los valores.

# --- Obligatorias ---
JIRA_URL=https://tu-sitio.atlassian.net
JIRA_EMAIL=tu.email@ejemplo.com
# Crealo en https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# --- Opcionales (estos son los valores por defecto) ---
# Proyectos del reporte: claves (AAA,BBB) o IDs (10001,10002) separados por coma.
# Vacío = todos los proyectos que tu usuario puede ver.
JIRA_PROJECTS=
# Cantidad de días hacia atrás, hoy incluido
DIAS=7
HORAS_MINIMAS_DIA=8
ZONA_HORARIA=America/Argentina/Buenos_Aires
# Nombres tal como aparecen en Jira, para detectar a quien no cargó nada
EQUIPO=
CARPETA_SALIDA=.
